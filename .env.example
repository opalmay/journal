# --- server ---
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
JOURNAL_TZ=Europe/Berlin
NODE_ENV=development

# --- secrets (generate with: openssl rand -hex 32) ---
SESSION_SECRET=change-me-to-a-32-byte-hex-string-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WEBHOOK_TOKEN=change-me-webhook-token

# --- auth: generate with `npm run hash-password -- 'your password'` ---
AUTH_PASSWORD_HASH=

# --- ai ---
AI_ENABLED=true
ANTHROPIC_API_KEY=

# --- uploads ---
MAX_UPLOAD_BYTES=67108864

# Which model writes what. Titles run once per entry (most of the calls);
# day summaries run once per day over everything in it.
AI_TITLE_MODEL=claude-haiku-4-5
AI_DAY_MODEL=claude-opus-5

# --- reminders (ntfy) ---
# The topic is generated by the server and shown in Settings. Point this at a
# self-hosted ntfy if you run one; set a token if the topic is access-controlled.
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
