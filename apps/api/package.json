{
  "name": "@journal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -b && cp -r src/db/migrations dist/db/",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@journal/shared": "*",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
